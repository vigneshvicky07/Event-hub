# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=eventhub
DB_USER=eventhub_user
DB_PASSWORD=eventhub_password
DB_HOST=db
DB_PORT=5432

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
USE_REDIS=true

# Set to true to run locally with SQLite and LocMemCache without Docker
USE_SQLITE=false
